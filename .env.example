# Copy to .env and adjust. No credentials are required: everything runs locally.

# Root directory for landing, bronze, silver, gold, quarantine and state folders.
LAKEFORGE_DATA_DIR=data

# Spark master URL. local[*] uses every core on this machine.
LAKEFORGE_SPARK_MASTER=local[*]

# Shuffle partitions; keep low for the small synthetic dataset.
LAKEFORGE_SHUFFLE_PARTITIONS=4

# Python logging level for pipeline logs.
LAKEFORGE_LOG_LEVEL=INFO

# Log level for Spark's JVM logs.
LAKEFORGE_SPARK_LOG_LEVEL=ERROR
